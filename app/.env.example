# TWAIN web app (Expo) configuration — copy to `app/.env` and fill in.
# `.env` is gitignored. Expo inlines EXPO_PUBLIC_* variables at build time.
#
# The values below are NOT secrets: a SPA (public) client using PKCE has no
# client secret. Do not put any client secret here.

# ── API ───────────────────────────────────────────────────────────────────────
# Where the app calls the FastAPI backend. dev.sh sets this for local runs; a
# cloud build bakes in the public API URL.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# Local dev only: skip SSO and let the app in without login (pair with the API's
# AUTH_DISABLED=true). Leave unset/false to exercise real Entra sign-in.
# EXPO_PUBLIC_AUTH_DISABLED=true

# ── WashU SSO (Microsoft Entra ID) ────────────────────────────────────────────
# Runs the OIDC auth-code + PKCE flow against the WashU tenant. See the "WashU
# SSO (Entra ID)" section of QUICKSTART.md for how to create the app registration
# and where each value comes from.

# WashU tenant (GUID). Defaults to WashU's in code, so this is optional.
# EXPO_PUBLIC_ENTRA_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6

# Application (client) ID of the "twain-web" SPA app registration. REQUIRED for SSO.
EXPO_PUBLIC_ENTRA_CLIENT_ID=

# API scope to request so the access token is audienced for the TWAIN API.
# Must match the scope exposed by the "twain-api" app registration. REQUIRED for SSO.
# Example: api://twain-api/access_as_user
EXPO_PUBLIC_ENTRA_API_SCOPE=

# ── Redirect URIs to register on the SPA app registration ─────────────────────
# The flow uses the app origin (custom scheme on native) as the redirect URI.
# Register these exactly (the app logs the resolved value at startup):
#   http://localhost:3001                     (web, local dev)
#   https://d1z5umg4xc2bl8.cloudfront.net      (web, prod)
#   twain://                                   (native, iOS/Android)
