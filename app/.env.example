# ─── Microsoft Entra ID (Azure AD) SSO — WashU federated login ────────────────
# Copy this file to `.env` (git-ignored) and fill in the real values.
#
#   cp .env.example .env
#
# These identifiers are NOT secrets (they ship in the public browser bundle),
# but are kept out of git per repo policy. There is NO client secret — this is a
# public SPA client using the auth-code + PKCE flow.
#
# The Entra app registration must use platform type "Single-page application
# (SPA)" and register each redirect URI EXACTLY (protocol + host + port + path):
#   - Dev:  http://localhost:8081        (Expo web default)
#   - Prod: https://<your-deployed-origin>

# Directory (tenant) ID — the WashU Entra tenant GUID.
EXPO_PUBLIC_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID — this SPA's app-registration GUID.
EXPO_PUBLIC_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional. Defaults to the browser origin (window.location.origin). Set only to
# force a specific redirect URI; it must be registered as a SPA redirect URI.
# EXPO_PUBLIC_AZURE_REDIRECT_URI=http://localhost:8081

# Optional. Where to send the browser after sign-out. Defaults to the origin.
# EXPO_PUBLIC_AZURE_POST_LOGOUT_REDIRECT_URI=http://localhost:8081

# ─── Existing config ──────────────────────────────────────────────────────────
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
