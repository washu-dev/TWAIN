# Copy to .env at the repo root. Read by the agent-mesh control plane
# (modules/16_agent_mesh_control_plane/AgentInterface.py) to talk to the hosted
# LLM gateway. The .env file itself is gitignored — never commit real secrets.

# ── LLM gateway credentials (required) ────────────────────────────────────────
# WashU AI API client-credentials. In deployed environments these come from
# AWS Secrets Manager instead (see runner/README.md).
API_KEY=
CLIENT_ID=
CLIENT_SECRET=

# ── LLM gateway connection (optional — defaults target the WashU gateway) ─────
# Override any of these to point at a different tenant, gateway, or model
# without code changes. See AgentInterface.DEFAULT_* for the baked-in fallbacks.
# TWAIN_AGENT_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# TWAIN_AGENT_SCOPE=api://bbeee386-60d6-4ba4-b9a7-631763f66065/.default
# TWAIN_AGENT_ENDPOINT=https://aiapi.wustl.edu/models/v2/messages
# TWAIN_AGENT_MODEL=claude-opus-4-8
# TWAIN_AGENT_MAX_TOKENS=1024

# ── Runner suspend notifications (optional — Phase 2) ─────────────────────────
# When a run pauses for the researcher (clarification, heavy-calc confirm, plan
# approval) the runner notifies them so they can return when ready. See
# runner/notifications.py. Default backend is 'log' (no infra).
# TWAIN_NOTIFY_BACKEND=log            # log | sns | ses | sendgrid
# TWAIN_APP_URL=https://app.example   # adds a deep link back to the run
# TWAIN_NOTIFY_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:...:twain-notify   # backend=sns
# Email backends route to the run's owner (users.email), falling back to:
# TWAIN_NOTIFY_EMAIL=you@example.edu  # ses/sendgrid recipient fallback
# TWAIN_NOTIFY_FROM=twain@example.edu # verified sender (SES: defaults to recipient; SendGrid: required)
# --- SendGrid (backend=sendgrid): email via the SendGrid HTTP API, no AWS ---
# TWAIN_SENDGRID_API_KEY=SG.xxxxxxxx  # your SendGrid API key (keep secret; never commit)

# ── Runner crash recovery (optional) ──────────────────────────────────────────
# A claimed job is kept alive by a heartbeat; if a runner dies mid-slice its lease
# expires and any runner (or the same one on restart) re-drives it from the
# checkpoint — so a crash no longer wedges a session. See runner/README.md.
# TWAIN_JOB_LEASE_SECONDS=600      # reclaim a job whose heartbeat is older than this
# TWAIN_JOB_HEARTBEAT_SECONDS=60   # how often a running job refreshes its lease
# TWAIN_JOB_MAX_ATTEMPTS=3         # attempts before a job is dead-lettered (run failed)
