# TWAIN configuration — copy to `.env` at the repo root and fill in.
# `.env` is gitignored; never commit real secrets. In AWS these values come from
# the ECS task definitions + Secrets Manager, NOT from this file.
#
# This is the single authoritative list of every environment variable TWAIN
# reads. Most have sensible defaults; only the LLM-gateway creds are required for
# a real run. `scripts/preflight.py` checks the important ones for you.

# ══ LLM gateway credentials (REQUIRED for any real run) ═══════════════════════
# WashU AI API client-credentials, read by the agent-mesh control plane
# (modules/16_agent_mesh_control_plane/AgentInterface.py). In cloud these are the
# three Secrets Manager entries wired by scripts/aws/setup_secrets.sh.
API_KEY=
CLIENT_ID=
CLIENT_SECRET=

# ══ LLM gateway connection (optional — defaults target the WashU gateway) ═════
# TWAIN_AGENT_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# TWAIN_AGENT_SCOPE=api://bbeee386-60d6-4ba4-b9a7-631763f66065/.default
# TWAIN_AGENT_ENDPOINT=https://aiapi.wustl.edu/models/v2/messages
# TWAIN_AGENT_MODEL=claude-opus-4-8
# TWAIN_AGENT_MAX_TOKENS=1024

# ══ Database (API + runner) ═══════════════════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twaindb
DB_USER=postgres
# Local: set the password here. Cloud: leave blank and set AWS_SECRET_ARN instead
# (the DB password is then read from Secrets Manager).
DB_PASSWORD=postgres
# AWS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:730335203321:secret:DBPASSWORD-xfmLoq
# AWS_REGION=us-east-1

# Apply DB migrations automatically when the API starts (default true). Set false
# only if you run migrations as a separate one-off task (python api/migrate.py).
# RUN_MIGRATIONS_ON_STARTUP=true

# ══ Auth (API) ════════════════════════════════════════════════════════════════
# Local dev only: inject a dev admin identity and skip login. NEVER set true in a
# shared or cloud deploy.
AUTH_DISABLED=true
# Production SSO (Microsoft Entra ID). Unset AUTH_DISABLED and set both:
# ENTRA_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# ENTRA_API_AUDIENCE=<API app-registration client id / App ID URI>
# Interim email login (pre-SSO). Enables POST /api/auth/login when set:
# INTERIM_JWT_SECRET=<random 32+ byte secret>
# INTERIM_ALLOWED_DOMAINS=wustl.edu
# BOOTSTRAP_ADMIN_EMAILS=you@wustl.edu

# ══ Runner execution mode ═════════════════════════════════════════════════════
# Run the generated calculation for real at EXECUTE (still behind the plan-
# approval gate). 0/unset = plan-only. Cloud runner sets this to 1.
# TWAIN_EXECUTE_LOCALLY=1
# Fully unattended: execute AND skip the human approval/heavy-calc gates.
# TWAIN_AUTO_RUN=0
# Submit the built bundle to a Slurm cluster instead of running locally/Docker.
# TWAIN_EXECUTE_SLURM=0
# TWAIN_SLURM_CLUSTER=compute2

# ══ Per-run budget rails (runner) ═════════════════════════════════════════════
# Deployment defaults; a per-run max_cost from the UI overrides TWAIN_RUN_MAX_COST.
# TWAIN_RUN_MAX_COST=1.0
# TWAIN_RUN_MAX_ITERATIONS=50
# TWAIN_RUN_WALL_MINUTES=30

# ══ Web app (Expo) ════════════════════════════════════════════════════════════
# Where the app calls the API. Local dev is set by dev.sh; a cloud build bakes
# the public API URL at build time.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# EXPO_PUBLIC_AUTH_DISABLED=true
