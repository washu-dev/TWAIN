# TWAIN configuration — copy to `.env` at the repo root and fill in.
# `.env` is gitignored; never commit real secrets. In AWS these values come from
# the ECS task definitions + Secrets Manager, NOT from this file.
#
# This is the single authoritative list of every environment variable TWAIN
# reads. Most have sensible defaults; only the LLM-gateway creds are required for
# a real run. `scripts/preflight.py` checks the important ones for you.

# ══ LLM gateway credentials (REQUIRED for any real run) ═══════════════════════
# WashU AI API client-credentials, read by the agent-mesh control plane
# (modules/16_agent_mesh_control_plane/AgentInterface.py). In cloud these are the
# three Secrets Manager entries wired by scripts/aws/setup_secrets.sh.
API_KEY=
CLIENT_ID=
CLIENT_SECRET=

# ── Local database (offline dev) ──────────────────────────────────────────────
# The API resolves DB credentials from AWS Secrets Manager (TWAIN/database/*)
# by default. For local dev without AWS credentials, set TWAIN_DB_FROM_ENV=true
# to use these DB_* values instead (dev.sh sets all of this automatically).
# TWAIN_DB_FROM_ENV=true
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=twaindb
# DB_USER=postgres
# DB_PASSWORD=postgres

# ── LLM gateway connection (optional — defaults target the WashU gateway) ─────
# Override any of these to point at a different tenant, gateway, or model
# without code changes. See AgentInterface.DEFAULT_* for the baked-in fallbacks.
# TWAIN_AGENT_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# TWAIN_AGENT_SCOPE=api://bbeee386-60d6-4ba4-b9a7-631763f66065/.default
# TWAIN_AGENT_ENDPOINT=https://aiapi.wustl.edu/models/v2/messages
# TWAIN_AGENT_MODEL=claude-opus-4-8
# TWAIN_AGENT_MAX_TOKENS=1024

# ── Runner suspend notifications (optional — Phase 2) ─────────────────────────
# When a run pauses for the researcher (clarification, heavy-calc confirm, plan
# approval) the runner notifies them so they can return when ready. See
# runner/notifications.py. Default backend is 'log' (no infra).
# TWAIN_NOTIFY_BACKEND=log            # log | sns | ses | sendgrid
# TWAIN_APP_URL=https://app.example   # adds a deep link back to the run
# Every backend targets the run's OWNER only: email to users.email, SMS (sns) to
# users.phone. There is no fallback destination -- a run whose owner has no
# address on file is not notified (logged at WARNING), because another person's
# inbox is never the right place for it. Populate users.email to fix that.
# TWAIN_NOTIFY_FROM=twain@example.edu # verified sender (SES: defaults to recipient; SendGrid: required)
# --- SendGrid (backend=sendgrid): email via the SendGrid HTTP API, no AWS ---
# TWAIN_SENDGRID_API_KEY=SG.xxxxxxxx  # your SendGrid API key (keep secret; never commit)
# Flood rails (per run, every backend). Defaults suit one researcher per run;
# raise them only if a run legitimately needs to say more. 0 disables a rail.
# TWAIN_NOTIFY_DEDUPE_SECONDS=120     # drop an identical repeat sent this recently
# TWAIN_NOTIFY_MAX_PER_HOUR=12        # hard ceiling on notifications per run per hour
# TWAIN_LOG_LEVEL=INFO                # runner log level; INFO records every send

# ── Runner crash recovery (optional) ──────────────────────────────────────────
# A claimed job is kept alive by a heartbeat; if a runner dies mid-slice its lease
# expires and any runner (or the same one on restart) re-drives it from the
# checkpoint — so a crash no longer wedges a session. See runner/README.md.
# TWAIN_JOB_LEASE_SECONDS=600      # reclaim a job whose heartbeat is older than this
# TWAIN_JOB_HEARTBEAT_SECONDS=60   # how often a running job refreshes its lease
# TWAIN_JOB_MAX_ATTEMPTS=3         # attempts before a job is dead-lettered (run failed)

# ══ Database (API + runner) ═══════════════════════════════════════════════════
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twaindb
DB_USER=postgres
# Local: set the password here. Cloud: leave blank and set AWS_SECRET_ARN instead
# (the DB password is then read from Secrets Manager).
DB_PASSWORD=postgres
# AWS_SECRET_ARN=arn:aws:secretsmanager:us-east-1:730335203321:secret:DBPASSWORD-xfmLoq
# AWS_REGION=us-east-1

# Apply DB migrations automatically when the API starts (default true). Set false
# only if you run migrations as a separate one-off task (python api/migrate.py).
# RUN_MIGRATIONS_ON_STARTUP=true

# ══ Auth (API) ════════════════════════════════════════════════════════════════
# Local dev only: inject a dev admin identity and skip login. NEVER set true in a
# shared or cloud deploy.
AUTH_DISABLED=true
# Production SSO (Microsoft Entra ID). Unset AUTH_DISABLED and set both:
# ENTRA_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# ENTRA_API_AUDIENCE=<API app-registration client id / App ID URI>
# Interim email login (pre-SSO). Enables POST /api/auth/login when set:
# INTERIM_JWT_SECRET=<random 32+ byte secret>
# INTERIM_ALLOWED_DOMAINS=wustl.edu
# BOOTSTRAP_ADMIN_EMAILS=you@wustl.edu

# ══ Runner execution mode ═════════════════════════════════════════════════════
# Run the generated calculation for real at EXECUTE (still behind the plan-
# approval gate). 0/unset = plan-only. Cloud runner sets this to 1.
# TWAIN_EXECUTE_LOCALLY=1
# Fully unattended: execute AND skip the human approval/heavy-calc gates.
# TWAIN_AUTO_RUN=0
# Submit the built bundle to a Slurm cluster instead of running locally/Docker.
# TWAIN_EXECUTE_SLURM=0
# TWAIN_SLURM_CLUSTER=compute2

# ══ Per-run budget rails (runner) ═════════════════════════════════════════════
# Deployment defaults; a per-run max_cost from the UI overrides TWAIN_RUN_MAX_COST.
# TWAIN_RUN_MAX_COST=1.0
# TWAIN_RUN_MAX_ITERATIONS=50
# TWAIN_RUN_WALL_MINUTES=30

# ══ Web app (Expo) ════════════════════════════════════════════════════════════
# App-side config lives in app/.env (see app/.env.example). These EXPO_PUBLIC_*
# values are inlined into the web bundle at build time and are NOT secrets.
# Where the app calls the API. Local dev is set by dev.sh; a cloud build bakes
# the public API URL at build time.
# EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
# EXPO_PUBLIC_AUTH_DISABLED=true
# WashU SSO (Entra ID) — the frontend half of the ENTRA_* config above. Tenant
# defaults to WashU's in code; client id + API scope come from the "twain-web"
# SPA app registration. See app/.env.example and QUICKSTART.md for setup.
# EXPO_PUBLIC_ENTRA_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# EXPO_PUBLIC_ENTRA_CLIENT_ID=<twain-web SPA app registration client id>
# EXPO_PUBLIC_ENTRA_API_SCOPE=api://twain-api/access_as_user
