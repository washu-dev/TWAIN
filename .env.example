# Copy to .env at the repo root. Read by the agent-mesh control plane
# (modules/16_agent_mesh_control_plane/AgentInterface.py) to talk to the hosted
# LLM gateway. The .env file itself is gitignored — never commit real secrets.

# ── LLM gateway credentials (required) ────────────────────────────────────────
# WashU AI API client-credentials. In deployed environments these come from
# AWS Secrets Manager instead (see runner/README.md).
API_KEY=
CLIENT_ID=
CLIENT_SECRET=

# ── LLM gateway connection (optional — defaults target the WashU gateway) ─────
# Override any of these to point at a different tenant, gateway, or model
# without code changes. See AgentInterface.DEFAULT_* for the baked-in fallbacks.
# TWAIN_AGENT_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# TWAIN_AGENT_SCOPE=api://bbeee386-60d6-4ba4-b9a7-631763f66065/.default
# TWAIN_AGENT_ENDPOINT=https://aiapi.wustl.edu/models/v2/messages
# TWAIN_AGENT_MODEL=claude-opus-4-8
# TWAIN_AGENT_MAX_TOKENS=1024
