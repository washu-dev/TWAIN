{
  "family": "twain-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::730335203321:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::730335203321:role/TWAIN-secrets-reader",
  "containerDefinitions": [
    {
      "name": "twain-api",
      "image": "730335203321.dkr.ecr.us-east-1.amazonaws.com/twain-ecr:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "AWS_REGION",          "value": "us-east-1" },
        { "name": "TWAIN_SECRET_PREFIX", "value": "TWAIN/database" },
        { "name": "GITHUB_ISSUE_REPO",   "value": "washu-dev/TWAIN" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/twain-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
}
