{
  "family": "twain-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::730335203321:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::730335203321:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "twain-api",
      "image": "730335203321.dkr.ecr.us-east-1.amazonaws.com/twain-ecr:latest",
      "portMappings": [
        {
          "containerPort": 8000,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "DB_HOST",   "value": "twain-app-database.cn8saqya88cd.us-east-1.rds.amazonaws.com" },
        { "name": "DB_PORT",   "value": "5432" },
        { "name": "DB_NAME",   "value": "twaindb" },
        { "name": "DB_USER",   "value": "postgres" },
        { "name": "AWS_REGION","value": "us-east-1" },
        { "name": "AWS_SECRET_ARN", "value": "arn:aws:secretsmanager:us-east-1:730335203321:secret:DBPASSWORD-xfmLoq" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/twain-api",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "essential": true
    }
  ]
}
