# Copy to api/.env for local development (run the API from the api/ directory),
# or export these in your shell before launching uvicorn.

# ── Local Postgres ────────────────────────────────────────────────────────────
# Homebrew Postgres usually has NO 'postgres' role — use your macOS username and
# an empty password. Find yours with: whoami
DB_HOST=localhost
DB_PORT=5432
DB_NAME=twaindb
DB_USER=CHANGE_ME_TO_YOUR_MACOS_USERNAME
DB_PASSWORD=

# ── Auth ──────────────────────────────────────────────────────────────────────
# Skip Entra sign-in locally: injects a dev admin identity so the app works
# without a token. NEVER enable this in a deployed environment.
AUTH_DISABLED=true

# ── Production auth (leave commented out locally) ─────────────────────────────
# ENTRA_TENANT_ID=4ccca3b5-71cd-4e6d-974b-4d9beb96c6d6
# ENTRA_API_AUDIENCE=api://twain-api/access_as_user
# BOOTSTRAP_ADMIN_EMAILS=you@wustl.edu
