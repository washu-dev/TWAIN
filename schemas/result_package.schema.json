{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ResultPackageSchema",
  "type": "object",
  "properties": {
    "result": {
      "type": "object",
      "properties": {
        "experiment_name": {
          "type": "string"
        },
        "conclusion":{
          "type": "string"
        },
        "certainty": {
          "type":"object",
          "properties": {
            "confidence_interval": {
              "type":"array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "exit_code": {
          "type": "number"
        }
      }
    },
    "output": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "path_to_file": {
            "type": "string"
          }
        }
      }
    },
    "resource_usage": {
      "type": "object",
      "properties": {
        "total_cost": {
          "type": "number",
          "minimum": 0
        },
        "tokens_used": {
          "type": "integer",
          "minimum": 0
        },
        "token_cost": {
          "type": "number",
          "minimum": 0
        },
        "cpu_hours": {
          "type":"number",
          "minimum": 0
        },
        "gpu_hours": {
          "type": "number",
          "minimum": 0
        },
        "slurm_cost": {
          "type":"number",
          "minimum": 0
        },
        "total_time": {
          "type": "string",
          "format": "time"
        },
        "start_time": {
          "type":"string",
          "format": "time"
        },
        "end_time": {
          "type": "string",
          "format": "time"
        }
      }
    },
    "metadata": {
      "type":"object",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "time"
        },
        "ID": {
          "type": "string"
        },
        "tools_used": {
          "type":"array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version":{
                "type": "number"
              }
            }
          }
        }
      }
    }
  }
}