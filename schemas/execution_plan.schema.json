{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExecutionPlanSchema",
  "type": "object",
  "required": ["selected_method","compute_estimate","slurm_request","cost_estimate","metadata","acceptance_metrics","safety_notes"],
  "properties": {
    "selected_method": {
      "type": "object",
      "required": ["tool_name","tool_version"],
      "properties": {
        "tool_name": {
          "type": "string"
        },
        "tool_version": {
          "type": "number"
        }
      }
    },
    "compute_estimate": {
      "type": "object",
      "required": ["cpu_hours"],
      "properties": {
        "cpu_hours": {
          "type": "number"
        }
      }
    },
    "slurm_request": {
      "type": "object",
      "required": ["cpu_count","gpu_count","max_time","ram"],
      "properties": {
        "cpu_count": {
          "type":"integer"
        },
        "gpu_count": {
          "type":"integer"
        },
        "max_time": {
          "type": "number"
        },
        "ram": {
          "description": "Requested memory in gigabytes (floor 4 at synthesize/submit).",
          "type": "integer"
        }
      }
    },
    "cost_estimate": {
      "type": "object",
      "required": ["min_tokens","min_cost"],
      "properties": {
        "min_tokens": {
          "type": "integer"
        },
        "min_cost": {
          "description": "USD",
          "type": "number"
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": ["timestamp","goal_id","candidate_rank"],
      "properties": {
        "timestamp":{
          "type": "string",
          "format": "date-time"
        },
        "goal_id": {
          "type": "string"
        },
        "candidate_rank": {
          "type": "integer"
        }
      }
    },
    "acceptance_metrics": {
      "type":"array",
      "items": {
        "type": "object",
        "required": ["metric_name","target_value","tolerance"],
        "properties": {
          "metric_name": {
            "type": "string"
          },
          "target_value": {
            "type":["number","null"],
            "description":"null means the researcher named this metric but gave no number to hit. Still required, so 'unspecified' is stated rather than left out -- a 0.0 placeholder would be judged literally."
          },
          "tolerance":{
            "type":["number","null"],
            "description":"null when target_value is null: there is no band to be inside of."
          }
        }
      }
    },
    "safety_notes": {
      "type":"array",
      "items": {
        "type": "string"
      }
    },
    "library_requests": {
      "description": "Libraries this plan wanted but could not use because they are not in the preset install set. Each was recorded and filed as a 'LibraryAddition' GitHub issue; the plan itself only ever uses installed libraries. Mirrored into safety_notes for the researcher.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["library", "source", "status"],
        "properties": {
          "library": {
            "description": "The library that was asked for, as named.",
            "type": "string"
          },
          "canonical": {
            "description": "Dedup key for the library name (lowercased, hyphenated).",
            "type": "string"
          },
          "source": {
            "description": "Who wanted it: the researcher, the discovery LLM, or the registry ranking.",
            "type": "string",
            "enum": ["user", "llm_discovery", "discovery_ranking"]
          },
          "reason": {
            "type": "string"
          },
          "alternative": {
            "description": "The installed library used instead.",
            "type": ["string", "null"]
          },
          "objective": {
            "type": ["string", "null"]
          },
          "run_id": {
            "type": ["string", "null"]
          },
          "status": {
            "description": "Outcome of filing the GitHub issue. 'queued' means recorded locally only (no GitHub credentials configured).",
            "type": "string",
            "enum": ["issue_created", "issue_exists", "queued", "issue_failed"]
          },
          "issue_number": {
            "type": ["integer", "null"]
          },
          "issue_url": {
            "type": ["string", "null"]
          },
          "first_requested_at": {
            "type": "string"
          },
          "last_requested_at": {
            "type": "string"
          },
          "occurrences": {
            "description": "How many times this library has been asked for across all runs.",
            "type": "integer"
          }
        }
      }
    },
    "summary": {
      "description": "Plain-language description of what the run will do (property, system, toolset, approach).",
      "type": ["string", "null"]
    }
  }
}
