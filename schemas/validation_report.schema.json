{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ValidationReportSchema",
  "type": "object",
  "properties": {
    "comparison": {
      "literature_results": {
        "type": "string"
      },
      "agreement": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "difference_analysis": {
        "type": "string"
      }
    },
    "acceptance_status": {
      "type": "string",
      "enum": ["accepted","rejected","needs_review"]
    },
    "metadata": {
      "ID": {
        "type": "string"
      },
      "timestamp": {
        "type": "string",
        "format": "time"
      }
    }
  }
}