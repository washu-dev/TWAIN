{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ValidationReportSchema",
  "type": "object",
  "required": ["comparison","acceptance_status","metadata"],
  "properties": {
    "comparison": {
      "type": "object",
      "required": ["literature_results","agreement","difference_analysis"],
      "properties": {
        "literature_results": {
          "type": "string"
        },
        "agreement": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "difference_analysis": {
          "type": "string"
        }
      }
    },
    "acceptance_status": {
      "type": "string",
      "enum": ["accepted","rejected","needs_review"]
    },
    "metadata": {
      "type": "object",
      "required": ["ID","timestamp"],
      "properties": {
        "ID": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "time"
        }
      }
    }
  }
}
