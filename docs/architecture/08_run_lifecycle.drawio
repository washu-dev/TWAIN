        <mxCell id="n9" value="INTAKE → CLARIFY →&#10;DECOMPOSE → DISCOVER&#10;(checkpoint each transition)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="668" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n10" value="Claude prompts:&#10;intent, questions, goal graph,&#10;tool discovery" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#f3e5f5;strokeColor=#6a1b9a;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1985" y="668" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n11" value="CLARIFY question?&#10;→ SuspendRun (run waits;&#10;no worker held)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="780" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n12" value="✉ &quot;needs your input&quot;" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2705" y="780" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n13" value="Answer the question" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="892" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n14" value="question card in chat" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="305" y="892" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n15" value="POST /messages&#10;→ resume job (outbox → SQS)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8eaf6;strokeColor=#283593;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="545" y="892" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n16" value="PLAN: Claude picks toolset;&#10;cluster_env_candidates vs&#10;inventory; approval gate&#10;(run.paused)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="1004" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="n17" value="Gate after PLAN&#10;toolset fits a probed env&#10;(planned)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#fafafa;strokeColor=#757575;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#424242;shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;size=12;" vertex="1" parent="1"><mxGeometry x="1745" y="1004" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n18" value="run_events + messages&#10;(approval_request,&#10;plan artifact)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ede7f6;strokeColor=#4527a0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="785" y="1116" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n19" value="✉ &quot;waiting for your approval&quot;" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffebee;strokeColor=#c62828;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="2705" y="1116" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n20" value="PlanCard + Tracker&#10;Plan ● &quot;Your plan is ready:&#10;review and approve it below&quot;" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="305" y="1228" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n21" value="③ Approve&#10;(may edit CPUs / RAM / wall time)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="1228" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n22" value="POST /approval&#10;→ resume job (outbox → SQS)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8eaf6;strokeColor=#283593;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="545" y="1340" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n23" value="BUILD: codegen (Claude +&#10;templates) → RunBundle&#10;main.py · requirements · smoke" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="1452" width="190" height="70" as="geometry" /></mxCell>
