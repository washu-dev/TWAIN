        <mxCell id="sec27" value="" style="line;strokeWidth=1;strokeColor=#90a4ae;dashed=1;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="3232" width="2880" height="2" as="geometry" /></mxCell>
        <mxCell id="seclabel27" value="F · Planned (observer, env approvals) + background inventory" style="text;html=0;fontSize=11;fontStyle=3;fontColor=#37474f;align=left;" vertex="1" parent="1"><mxGeometry x="44" y="3230" width="330" height="18" as="geometry" /></mxCell>
        <mxCell id="lg1" value="PIZZA TRACKER (RunTracker) — 5 phases, 14 states&#10;&#10;Plan:  INTAKE · CLARIFY · DECOMPOSE · DISCOVER · PLAN&#10;Build:  BUILD · REPAIR&#10;Run on RIS:  EXECUTE&#10;Check:  INTERPRET · VALIDATE · CORRECT · REPLAN&#10;Results:  ACCEPT · TERMINATE&#10;&#10;Done phases green · current pulses red (Reduce Motion&#10;honoured) · failed phase ✕ · cancelled grey.&#10;Approval gate highlights Plan (&quot;Your plan is ready&quot;).&#10;Status line = newest active subtask label, else the&#10;phase description; exact state shown at right." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#1565c0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2960" y="110" width="470" height="250" as="geometry" /></mxCell>
        <mxCell id="lg2" value="SUBTASKS (RunActivity checklist)&#10;&#10;stage.progress events {stage, step, status, label}:&#10;BUILD codegen · bundle; REPAIR smoke · review · fix;&#10;EXECUTE stage → preflight → submit → queue → run → fetch;&#10;heal (runtime repair attempt k of N).&#10;job.log = stdout tail (byte cursor). App polls&#10;GET /activity?after= every 2 s." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#2e7d32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2960" y="380" width="470" height="160" as="geometry" /></mxCell>
        <mxCell id="lg3" value="EMAILS (runner/notifications.py)&#10;&#10;Kinds: input · approval · completed · failed · terminated&#10;Backend TWAIN_NOTIFY_BACKEND=sendgrid (else log);&#10;sender TWAIN_NOTIFY_FROM; link TWAIN_APP_URL.&#10;Only to the run's owner; per-user prefs (Settings);&#10;dedupe 120 s, max 12 / run / hour.&#10;Planned: env-change approvals → TWAIN_ENV_APPROVERS." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#c62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2960" y="560" width="470" height="170" as="geometry" /></mxCell>
        <mxCell id="lg4" value="OBSERVER (planned, #185 P1b → #188)&#10;&#10;Separate subscriber to stage.completed; judges a stage's&#10;output before the next stage starts.&#10;P1b deterministic gates: PLAN fits a probed env; BUILD has&#10;the system + produces the metric + resources ≤ approved;&#10;EXECUTE outputs exist/parse.&#10;Verdict: pass · send back (run-scoped fix, budget 3) ·&#10;escalate. Shared-env changes → proposal + email approval.&#10;P4: LLM judgement, independent of the producing agent." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fontFamily=Helvetica;fillColor=#ffffff;strokeColor=#757575;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="2960" y="750" width="470" height="220" as="geometry" /></mxCell>
        <mxCell id="lg5" value="KEY&#10;&#10;Thick orange box = human touchpoint&#10;Dashed grey box / hexagon = planned (not built yet)&#10;Red arrow = email · dashed arrow = async / event&#10;Hexagon = observer gate&#10;&#10;Source of truth for planning: the newest RIS inventory&#10;(ris_inventory); env specs only as fallback." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#fffde7;strokeColor=#f9a825;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2960" y="990" width="470" height="160" as="geometry" /></mxCell>
        <mxCell id="n1" value="① Describe the simulation&#10;(&quot;predict the aqueous solubility&#10;of aspirin at 25 °C&quot;)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ffe0b2;strokeColor=#e65100;strokeWidth=3;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="65" y="220" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n2" value="Chat screen&#10;new run" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="305" y="220" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n3" value="POST /api/conversations&#10;(Entra token; owner = user)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8eaf6;strokeColor=#283593;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="545" y="332" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n4" value="jobs row status='dispatching'&#10;(transactional outbox)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#ede7f6;strokeColor=#4527a0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="785" y="332" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n5" value="start message&#10;group = session&#10;dedup = job-&lt;id&gt;" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#fce4ec;strokeColor=#ad1457;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1025" y="444" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n6" value="relay: re-sends rows still&#10;unpublished after 30 s&#10;(SQS send failed)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#f1f8e9;strokeColor=#558b2f;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1505" y="444" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="n7" value="② consume + claim job by id&#10;apply latest RIS inventory&#10;(planning truth)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="556" width="190" height="70" as="geometry" /></mxCell>
