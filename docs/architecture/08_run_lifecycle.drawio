        <mxCell id="n25" value="REPAIR: script doctor&#10;&quot;Reviewing the script for&#10;latent problems&quot; (subtask)" style="rounded=1;whiteSpace=wrap;html=0;fontSize=10;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1265" y="1564" width="190" height="70" as="geometry" /></mxCell>
