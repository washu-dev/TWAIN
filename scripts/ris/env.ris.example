# RIS backend runner configuration.
# Copy to the REPO ROOT as `.env.ris` and fill in the two secrets;
# scripts/ris/deploy.sh installs it on the cluster as `.env` (chmod 600).

# ── WashU LLM gateway (same credentials as your local .env) ──────────────────
API_KEY=
CLIENT_ID=
CLIENT_SECRET=

# ── Shared Postgres on AWS RDS (the same DB the API and web UI use) ──────────
DB_HOST=twain-app-database.cn8saqya88cd.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=twaindb
DB_USER=postgres
# The RDS password (ask the team / read the DBPASSWORD secret in Secrets
# Manager). The RIS runner uses this directly -- no AWS credentials needed.
DB_PASSWORD=

# ── Materials Project (optional) ─────────────────────────────────────────────
# Enables database-retrieval tasks ("look up the stored bulk modulus of X"):
# generated MPRester scripts read this key at run time. Free key from
# https://materialsproject.org/api. Leave empty to have such runs fail fast at
# BUILD with a clear message instead of on the cluster.
MP_API_KEY=

# ── Execution mode (defaults set by start_runner.sh; uncomment to override) ──
# TWAIN_EXECUTE_SLURM=1
# TWAIN_SLURM_CLUSTER=compute2
# TWAIN_RUN_MAX_COST=1.0
